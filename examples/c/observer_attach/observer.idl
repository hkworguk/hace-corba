// Reference only -- not processed by any tool (no idlc yet, Phase 4).
//
// `in Observer obs` is hand-mapped as a CDR-encoded object reference
// (hace_corba_ior_encode/decode), since there is no generated stub to
// marshal an object reference parameter automatically.
module HaceExamples {
    interface Observer {
        oneway void update(in string event);
    };
    interface Subject {
        void attach(in Observer obs);
    };
};
